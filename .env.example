# SQLite file for local development (relative to the project root)
DATABASE_URL="file:./prisma/dev.db"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Microsoft Entra ID (Azure AD) single sign-on
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID=""

# Where uploaded documents are stored on disk (local storage driver)
STORAGE_DIR="./storage"
