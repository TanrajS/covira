# PostgreSQL. Locally: run `npx prisma dev --name covira --detach` and paste the
# TCP URL it prints. On Vercel this is injected by the Neon / Prisma Postgres
# Marketplace integration.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Microsoft Entra ID (Azure AD) single sign-on
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID=""

# Document storage. When BLOB_READ_WRITE_TOKEN is set (Vercel Blob, PRIVATE
# store) files go to Blob; otherwise they're written to STORAGE_DIR on disk.
# BLOB_READ_WRITE_TOKEN=""
STORAGE_DIR="./storage"

# Show one-click demo logins on the sign-in page in production builds.
# SHOW_DEMO_ACCOUNTS="1"
